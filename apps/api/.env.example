DATABASE_URL="file:./dev.db"
PORT=3000
# Set both values on first startup to create the initial Super Admin.
# Use a unique password of at least 12 characters, then remove it from the environment.
AUTH_INITIAL_ADMIN_EMAIL=admin@example.com
AUTH_INITIAL_ADMIN_PASSWORD=
# Set to true when the app is served over HTTPS.
AUTH_COOKIE_SECURE=false
# Add every browser origin that is allowed to use the API.
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
# Set to 1 only when the API is behind a trusted reverse proxy.
TRUST_PROXY=0
# Set to a private random value with at least 32 characters before adding notification channels.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# ALERT_ENCRYPTION_KEY=
# Device SNMPv3 and RouterOS passwords use a separate key.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# DEVICE_ENCRYPTION_KEY=
