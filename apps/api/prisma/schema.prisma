generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Device {
  id          String   @id @default(cuid())
  name        String
  ipAddress   String   @unique
  snmpPort    Int      @default(161)
  snmpVersion String   @default("2c")
  community   String
  snmpSecurityName     String?
  snmpSecurityLevel    String   @default("authPriv")
  snmpAuthProtocol     String   @default("sha")
  snmpAuthPassword     String?
  snmpPrivProtocol     String   @default("aes")
  snmpPrivPassword     String?
  apiPort     Int      @default(8728)
  routerOsPort Int     @default(443)
  username    String?
  password    String?
  enabled     Boolean  @default(true)

  lastSeen    DateTime?
  downSince   DateTime?
  status      String   @default("unknown")
  lastError   String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  metrics Metric[]
  snapshot  DeviceSnapshot?
  groups DeviceGroupMembership[]
  tags DeviceTagAssignment[]
  alerts Alert[]
  events DeviceEvent[]
}

model Metric {
  id         String   @id @default(cuid())
  deviceId   String
  oid        String
  name       String
  value      String
  unit       String?
  createdAt  DateTime @default(now())
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([deviceId, name, createdAt])
  @@index([name, createdAt])
}

model DeviceSnapshot {
  id         String   @id @default(cuid())

  deviceId   String   @unique
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  hostname   String?
  uptime     String?
  cpu        String?

  lastSeen   DateTime
  updatedAt  DateTime @updatedAt
}

model DeviceGroup {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  devices     DeviceGroupMembership[]
  alertRules  AlertRule[]
}

model DeviceGroupMembership {
  deviceId  String
  groupId   String
  createdAt DateTime @default(now())
  device    Device      @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  group     DeviceGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([deviceId, groupId])
  @@index([groupId])
}

model DeviceTag {
  id        String   @id @default(cuid())
  name      String   @unique
  devices   DeviceTagAssignment[]
}

model DeviceTagAssignment {
  deviceId String
  tagId    String
  device   Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  tag      DeviceTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([deviceId, tagId])
  @@index([tagId])
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AlertRule {
  id              String   @id @default(cuid())
  name            String
  type            String
  severity        String   @default("HIGH")
  threshold       Float?
  durationSeconds Int      @default(0)
  enabled         Boolean  @default(true)
  groupId         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  group           DeviceGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  events          Alert[]
  channels        AlertRuleChannel[]

  @@index([enabled, type])
}

model Alert {
  id              String   @id @default(cuid())
  ruleId          String
  deviceId        String?
  deviceName      String
  deviceIpAddress String
  message         String
  value           String?
  state           String   @default("open")
  triggeredAt     DateTime @default(now())
  acknowledgedAt  DateTime?
  acknowledgedBy  String?
  resolvedAt      DateTime?
  rule            AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  device          Device?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([state, triggeredAt])
  @@index([deviceId, ruleId, state])
}

model DeviceEvent {
  id        String    @id @default(cuid())
  deviceId  String
  type      String
  subject   String
  message   String
  startedAt DateTime  @default(now())
  resolvedAt DateTime?
  device    Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, startedAt])
  @@index([deviceId, type, subject, resolvedAt])
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         String    @default("VIEWER")
  enabled      Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]

  @@index([enabled, role])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorEmail String?
  action    String
  method    String
  path      String
  status    Int
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([status, createdAt])
}

model PollJob {
  id          String   @id
  status      String   @default("PENDING")
  requestedAt DateTime @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  nextAttemptAt DateTime?
  attempts    Int      @default(0)
  maxAttempts Int      @default(3)
  result      String?
  error       String?

  @@index([status, requestedAt])
  @@index([status, nextAttemptAt])
  @@index([completedAt])
}

model NotificationChannel {
  id        String   @id @default(cuid())
  name      String
  type      String
  config    String
  enabled   Boolean  @default(true)
  lastSentAt DateTime?
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rules     AlertRuleChannel[]
}

model AlertRuleChannel {
  ruleId    String
  channelId String
  rule      AlertRule         @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  channel   NotificationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([ruleId, channelId])
  @@index([channelId])
}

model AggregatedMetric {
  id        String   @id @default(cuid())
  deviceId  String
  name      String
  bucketStart DateTime
  avgValue  Float
  minValue  Float
  maxValue  Float
  count     Int
  createdAt DateTime @default(now())

  @@index([deviceId, name, bucketStart])
  @@index([bucketStart])
}
