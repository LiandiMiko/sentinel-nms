{
  "name": "sentinel-nms",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "api": "npm run dev --workspace=api",
    "web": "npm run dev --workspace=web --",
    "collector": "npm run dev --workspace=collector",
    "scheduler": "npm run dev --workspace=scheduler",
    "worker": "npm run start --workspace=scheduler",
    "preflight": "npm run preflight --workspace=api",
    "verify:backup": "npm run test:backup --workspace=api",
    "verify:worker": "npm run test:worker --workspace=api"
  }
}